WHITESPACE = _{ " " | NEWLINE }

program = { SOI ~ statement* ~ EOI }

    statement = { for_loop | assignment | expression_statement }
        for_loop = { "for" ~ identifier ~ "in" ~ term ~ "{" ~ statement* ~ "}" }
        assignment = { identifier ~ "=" ~ expression ~ ";" }
        expression_statement = { expression ~ ";" }

    identifier = @{ ASCII_ALPHA_LOWER ~ ASCII_ALPHA* }
    expression = { term ~ (">>" ~ term)* }
        term = { atom ~ (call | index | slice)* }
            atom = { integer_literal | negative_integer | string_literal | identifier | array }
                negative_integer = { "-" ~ integer_literal }
                integer_literal = @{ ASCII_DIGIT+ }
                string_literal = @{ "'" ~ (!"'" ~ ANY)* ~ "'"}
                array = { "[" ~ (expression ~ ("," ~ expression)*)? ~ "]"}
            // For now, we only allow single-argumment function calls
            call = { "(" ~ expression ~ ("," ~ expression)* ~ ")" }
            index = { "[" ~ expression ~ "]" }
            slice = { "[" ~ slice_start? ~ ":" ~ slice_end? ~ (":" ~ slice_step)? ~ "]" }
                slice_start = { expression }
                slice_end = { expression }
                slice_step = { expression }
